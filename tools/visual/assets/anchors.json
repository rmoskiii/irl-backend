  "bubbles": {
    "treatment": "balloon",
    "note": "LOCKED: rounded balloon with a tail to the speaker (design variant 1). Bubbles are GENERATED from render_blocks.json at compose time - they are not an asset file. Geometry lives here; the renderer is build_bubbles() in compose_frame.py. Enable per frame with `bubblesFrom: <node>` and compose with --bubbles.",
    "maxChars": 120,
    "maxPerNode": 3,
    "fontSize": 47,
    "lineHeight": 57,
    "charsPerLine": 19,
    "maxWidth": 580,
    "cornerRadius": 30,
    "gap": 20,
    "padding": 28,
    "paddingY": 41,
    "firstBaseline": 55,
    "tailInset": 40,
    "strokeWidth": 4.4,
    "typeScaleNote": "Type is sized against the DEVICE, not the canvas. The artwork is contained 16:9 in a ~390pt phone width, so the canvas-to-device factor is 0.244 and the previous fontSize 26 rendered at 6.3pt - roughly half a legible size. 47 renders at 11.5pt. maxWidth grew and every placement origin moved left in step, because a wider balloon at the old x=250/292 origin would have crossed the centre-slot figure at x=664. paddingY, firstBaseline and tailInset were hard-coded in build_bubbles() as 34/40/26; they are contract values now so the balloon scales with the type instead of splitting from it.",
    "placement": {
      "left": {
        "x": 700,
        "y": 104
      },
      "centre": {
        "x": 48,
        "y": 104
      },
      "right": {
        "x": 48,
        "y": 104
      },
      "note": "Per-slot stack origin. Explicit rather than computed: the free area in a room is a compositional fact about that room, not something derivable from the slot alone. Each new environment must declare placements for the slots it uses."
    },
    "tailTarget": {
      "dx": -70,
      "dy": 150,
      "note": "Offset from the speaker's resolved head socket to the tail apex - chin/neck height, just inside the near cheek. Resolved through the same slot transform as the figure, so the tail tracks the speaker at any slot without hand-placement."
    },
    "tail": {
      "length": 54,
      "baseWidth": 26,
      "note": "Length is CLAMPED. The tail aims at the speaker but stops short; an unclamped tail becomes a thin spike across the artwork, which is what made variant 1 read badly in the first design pass. Drawn on the last bubble only - a tail per bubble reads as noise."
    },
    "placementNote": "Global defaults live in bubbles.placement. A scene may override them via scenes.<id>.bubblePlacement.<slot> when its free area differs - where a bubble can sit is a compositional fact about the room, not a property of the slot."
  },
  "environmentContract": {
    "occlusionLine": 600,
    "rule": "EVERY IRX environment must provide an occluding surface at y=600. This is not a stylistic preference - both figure bodies are drawn with arms reaching forward and hands flat at local y~500, which resolves to canvas y~600. A room with no surface there leaves the hands floating in mid-air. The surface can be anything plausible for the room (counter, console table, cafe table, low wall, bar) but it must exist and it must sit at 600.",
    "discovered": "2B.3, before flat_hallway was drawn. scene.kitchen satisfied it by accident because the counter was designed first and the figure was fitted to it.",
    "alternative": "If a future scene genuinely cannot have a surface there, it needs an arms-down body variant - which is what figure_a_rear and figure_b_rear already are. Do not solve it by moving the occlusion line per scene; that would desynchronise the hands from every existing wardrobe."
  },
  "propsRemoved": {
    "prop.jacket_worn": "NOT A PROP. Used by one node (confession_guarded) where Jessica's wardrobe is already `coat` - the jacket she is reaching for is the garment she is wearing. Reclassified as wardrobe-provided; mapping.the_secret.json should move 'jacket' to unrenderableProps."
  },
  "montage": {
    "matte": "--irx-vig-dark",
    "frame": "--irx-vig-light",
    "frameWidth": 3,
    "panelWidth": 440,
    "panelHeight": 550,
    "sourceWidth": 480,
    "gap": 48,
    "top": 140,
    "captionGap": 48,
    "captionSize": 22,
    "note": "Montage is a first-class presentation mode, not a scene with the figure removed. Panels are reduced-fidelity vignettes on a dark matte, so compressed time reads differently from present tense without a caption having to say so."
  },
