{
  "schemaVersion": 1,
  "phase": "2A",
  "note": "Canonical coordinate contract for the IRX visual asset system. compose_frame.py reads ONLY this file to place assets. If a frame needs an offset that is not in here, the contract is wrong \u2014 fix the contract, not the frame.",
  "canvas": {
    "viewBox": "0 0 1600 900",
    "width": 1600,
    "height": 900,
    "aspect": "16:9",
    "rationale": "Phase 1 defines no canvas. 16:9 chosen for the investor demo surface (ScenarioDemo + deck). Mobile crops to a 4:5 safe area, documented below."
  },
  "safeArea": {
    "mobile_4_5": {
      "x": 440,
      "y": 0,
      "width": 720,
      "height": 900
    },
    "note": "Anything narratively load-bearing must sit inside mobile_4_5. Slot 'centre' is centred within it."
  },
  "layerOrder": [
    "background",
    "architecture",
    "environmental_detail",
    "character_back",
    "character_body",
    "character_clothing",
    "character_head",
    "furniture",
    "prop",
    "character_contact",
    "character_front",
    "foreground",
    "bubbles"
  ],
  "layerNote": "Phase 1 established no layer convention, so the Phase 2A brief's list is adopted with changes forced by the artwork: (1) character_face/character_hair are NOT separate top-level layers - a register is one atomic swappable unit and splitting it would let face and hair desynchronise; (2) 'furniture' sits AFTER character_head so the counter occludes the figure below counter height; (3) 'character_front' (hands) sits after 'prop' so hands rest on the counter surface; (4) ADDED IN QA: 'character_contact' between prop and character_front carries contact shadows. Without it the figure read as pasted onto the background. 'character_back' carries the figure's cast shadow on the wall.",
  "character": {
    "localViewBox": "0 0 420 800",
    "basePoint": {
      "x": 210,
      "y": 800,
      "note": "bottom-centre; lands on the scene slot anchor"
    },
    "headSocket": {
      "x": 210,
      "y": 210,
      "note": "where the register's neckAnchor lands"
    },
    "note": "DEPRECATED as a global. Retained for backward compatibility with existing frames; new work should read anchors.characters[<base>]. neckSpan was never global - it is derived from a specific figure's neck geometry, and figure_b will differ. Generalised at the start of 2B, before a second character existed to break it."
  },
  "register": {
    "localViewBox": "0 0 200 220",
    "neckAnchor": {
      "x": 100,
      "y": 210
    },
    "note": "A register may apply its own rotation about neckAnchor (declared as data-register-rotate on the root <g>). Rotation about the anchor keeps the join mechanical while allowing head tilt to carry part of the register.",
    "rotateLimit": {
      "min": -16,
      "max": 16,
      "note": "Rotation is TILT only. It cannot produce yaw. A turned head must be redrawn in the register, not rotated."
    },
    "neckSpanNote": "Per-character; see anchors.characters[<base>].neckSpan. Rotation remains global and is TILT only, bounded by rotateLimit."
  },
